{
  "name": "thumder",
  "version": "1.11.1",
  "private": true,
  "description": "TFG - THUMDER (THe UltiMate Dlx EmulatoR): emulador multiplataforma DLX con fines didácticos",
  "keywords": [
    "angular",
    "electron",
    "nodejs",
    "typescript",
    "sass",
    "windows",
    "mac",
    "linux",
    "dlx",
    "windlx",
    "DLX-emulator",
    "simulator",
    "vitest",
    "biome"
  ],
  "homepage": "https://github.com/nonodev96/THUMDER",
  "author": {
    "name": "Antonio Mudarra Machuca",
    "email": "nonodev96@gmail.com"
  },
  "main": "main.js",
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "postinstall": "node scripts/setup-env.js && node scripts/licenses.mjs",
    "dev": "ng run thumder-angular-electron:serve:dev -o",
    "ng:build:dev": "ng run thumder-angular-electron:build:dev",
    "ng:build:web": "ng run thumder-angular-electron:build:web",
    "ng:build:production": "ng run thumder-angular-electron:build:production",
    "ng:serve:dev": "ng run thumder-angular-electron:serve:dev -o",
    "ng:serve:web": "ng run thumder-angular-electron:serve:web -o",
    "ng:serve:production": "ng run thumder-angular-electron:serve:production -o",
    "start": "node scripts/parallel.mjs electron:serve ng:serve:dev",
    "build": "pnpm run electron:serve-tsc && ng build --base-href ./",
    "build:prod": "pnpm run electron:serve-tsc && ng build --base-href ./ --configuration production",
    "electron:local": "pnpm run build:prod && npx electron .",
    "electron:build": "pnpm run build:prod && electron-builder build",
    "electron:serve-tsc": "tsc -p tsconfig.serve.json",
    "electron:serve": "node scripts/wait-port.mjs 4200 && pnpm run electron:serve-tsc && npx electron . --serve",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "test:rules": "firebase emulators:exec --only firestore --project demo-thumder \"vitest run --config vitest.rules.config.ts\"",
    "e2e": "playwright test",
    "version": "node scripts/changelog.mjs",
    "lint": "biome check src/ main.ts preload.ts e2e/ test/ vitest.rules.config.ts",
    "lint:fix": "biome check --write src/ main.ts preload.ts e2e/ test/ vitest.rules.config.ts",
    "e2e:electron": "pnpm run build:prod && playwright test --config playwright.electron.config.ts"
  },
  "dependencies": {
    "@angular/build": "20.3.40",
    "@angular/cdk": "20.2.14",
    "@angular/common": "20.3.34",
    "@angular/compiler": "20.3.34",
    "@angular/compiler-cli": "20.3.34",
    "@angular/core": "20.3.34",
    "@angular/fire": "20.1.1",
    "@angular/forms": "20.3.34",
    "@angular/platform-browser": "20.3.34",
    "@angular/router": "20.3.34",
    "@fortawesome/fontawesome-free": "5.15.4",
    "@ngx-translate/core": "17.0.0",
    "@ngx-translate/http-loader": "17.0.0",
    "@pixi/unsafe-eval": "7.4.3",
    "admin-lte": "3.1.0",
    "firebase": "11.10.0",
    "marked": "^16.4.2",
    "monaco-editor": "^0.55.1",
    "ngx-markdown": "20.1.0",
    "pixi.js": "7.4.3",
    "prismjs": "1.30.0",
    "rxjs": "7.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/cli": "20.3.40",
    "@angular/language-service": "20.3.34",
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.4.12",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "fake-indexeddb": "^6.2.5",
    "firebase-tools": "15.34.0",
    "jsdom": "30.1.3",
    "tslib": "^2.0.0",
    "typescript": "5.8.3",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=18.19.0"
  },
  "pnpm": {
    "overrides": {
      "vite": "7.3.6",
      "@grpc/grpc-js": "1.14.6",
      "@modelcontextprotocol/sdk": "^1.31.0",
      "dompurify": "3.4.17",
      "uuid@<11.1.1": "11.1.1",
      "summernote": "-",
      "sweetalert2": "-",
      "katex": "-",
      "mermaid": "-",
      "global-agent": "-",
      "karma": "-",
      "firebase-tools>chokidar": "4.0.3",
      "@google-cloud/pubsub>@opentelemetry/core": "2.12.0"
    }
  }
}
