    "@covalent/code-editor": "3.1.2",
    "@babel/runtime": "7.26.0",
    "@fortawesome/fontawesome-free": "5.15.4",
    "@ngx-translate/core": "14.0.0",
    "@ngx-translate/http-loader": "7.0.0",
    "@popperjs/core": "2.9.1",
    "admin-lte": "3.1.0",
