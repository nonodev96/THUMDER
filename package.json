    "ngx-toastr": "14.1.0",
    "package-json-type": "1.0.3",
    "pixi.js": "7.4.3",
    "pixi.js-keyboard": "^1.1.6",
    "pixi.js-mouse": "^1.1.6",
    "rxfire": "6.0.3",
    "rxjs": "7.8.1",
    "string-to-argv": "1.0.0",
    "thumder-ontology": "1.1.1",
    "@xterm/xterm": "6.0.0",
    "@xterm/addon-attach": "0.12.0",
    "@xterm/addon-fit": "0.11.0",
