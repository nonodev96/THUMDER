    "@angular/language-service": "19.2.21",
    "@cypress/schematic": "1.5.1",
    "@pixi/canvas-renderer": "7.4.3",
    "@types/chart.js": "2.9.29",
    "@types/jasmine": "~3.6.0",
    "@types/jasminewd2": "2.0.8",
    "@types/jquery": "3.5.6",
    "@types/mocha": "8.0.3",
    "@types/node": "14.14.35",
