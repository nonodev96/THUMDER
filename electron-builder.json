{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.nonodev96.thumder",
  "productName": "THUMDER",
  "artifactName": "${productName}-v${version}-${os}-${arch}.${ext}",
  "asar": true,
  "npmRebuild": false,
  "nodeGypRebuild": false,
  "directories": {
    "output": "release/",
    "buildResources": "build"
  },
  "files": [
    "dist-electron/**/*.js",
    "package.json",
    "dist/browser/**/*",
    "!dist/browser/**/*.map",
    "!node_modules/**/*"
  ],
  "publish": {
    "provider": "github",
    "owner": "nonodev96",
    "repo": "THUMDER",
    "releaseType": "draft"
  },
  "win": {
    "icon": "build/icon.ico",
    "target": [
      "nsis",
      "portable"
    ]
  },
  "mac": {
    "icon": "build/icon.icns",
    "category": "public.app-category.education",
    "target": [
      "dmg",
      "zip"
    ],
    "darkModeSupport": true
  },
  "linux": {
    "icon": "build/icons",
    "category": "Education",
    "target": [
      "AppImage"
    ],
    "synopsis": "Simulador de los procesadores DLX y SuperDLX",
    "desktop": {
      "entry": {
        "Name": "THUMDER",
        "GenericName": "Simulador DLX",
        "Keywords": "DLX;SuperDLX;WinDLX;simulador;simulator;pipeline;superescalar;ensamblador;assembler;"
      }
    },
    "syncDesktopName": true,
    "description": "Simulador de los procesadores DLX y SuperDLX: pipeline, superescalar, ensamblador y ejercicios"
  }
}
