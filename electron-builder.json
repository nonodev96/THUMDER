{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.nonodev96.thumder",
  "productName": "THUMDER",
  "artifactName": "${productName}-v${version}-${os}-${arch}.${ext}",
  "asar": true,
  "npmRebuild": false,
  "nodeGypRebuild": false,
  "directories": {
    "output": "release/"
  },
  "files": [
    "main.js",
    "preload.js",
    "package.json",
    "dist/browser/**/*",
    "!dist/browser/**/*.map",
    "!node_modules/**/*"
  ],
  "publish": {
    "provider": "github",
    "owner": "nonodev96",
    "repo": "THUMDER",
    "releaseType": "draft"
  },
  "win": {
    "icon": "dist/browser/assets/icons/favicon.ico",
    "target": ["nsis", "portable"]
  },
  "mac": {
    "icon": "dist/browser/assets/icons/favicon.icns",
    "category": "public.app-category.education",
    "target": ["dmg", "zip"]
  },
  "linux": {
    "icon": "dist/browser/assets/icons",
    "category": "Education",
    "target": ["AppImage"]
  }
}
