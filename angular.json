{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "thumder-angular-electron": {
      "root": "",
      "sourceRoot": "src",
      "projectType": "application",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "dist"
            },
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "src/tsconfig.app.json",
            "polyfills": [
              "zone.js",
              "src/global-shim.ts"
            ],
            "inlineStyleLanguage": "scss",
            "allowedCommonJsDependencies": [
              "@firebase/app-check",
              "datastructures-js"
            ],
            "assets": [
              "src/assets",
              {
                "glob": "_redirects",
                "input": "src",
                "output": "/"
              },
              {
                "glob": "manifest.webmanifest",
                "input": "src",
                "output": "/"
              },
              {
                "glob": "*.png",
                "input": "./assets/",
                "output": "./assets/"
              },
              {
                "glob": "*.png",
                "input": "./assets/screenshots/",
                "output": "./assets/screenshots/"
              },
              {
                "glob": "LICENSE.md",
                "input": "./",
                "output": "./assets/md/"
              },
              {
                "glob": "CHANGELOG.md",
                "input": "./",
                "output": "./assets/md/"
              },
              {
                "glob": "README*.md",
                "input": "./",
                "output": "./assets/md/"
              },
              {
                "glob": "CONTRIBUTING*.md",
                "input": "./",
                "output": "./assets/md/"
              },
              {
                "glob": "**/*",
                "input": "./docs",
                "output": "./assets/docs/"
              },
              {
                "glob": "ABOUT.md",
                "input": "./",
                "output": "./assets/md/"
              },
              {
                "glob": "DLX-TABLE-Instructions.md",
                "input": "./",
                "output": "./assets/md/"
              }
            ],
            "styles": [
              "src/styles.scss",
              "node_modules/monaco-editor/min/vs/editor/editor.main.css",
              "src/assets/flag-icons-master/css/flag-icon.css",
              "src/assets/styles/bootstrap-4-xxl.css",
              "node_modules/@fortawesome/fontawesome-free/css/all.css",
              "node_modules/admin-lte/dist/css/adminlte.css",
              "node_modules/prismjs/themes/prism-okaidia.css",
              "node_modules/prismjs/plugins/line-highlight/prism-line-highlight.css",
              "src/theme.scss"
            ],
            "scripts": [
              "node_modules/prismjs/prism.js",
              "node_modules/prismjs/components/prism-typescript.min.js",
              "node_modules/prismjs/components/prism-javascript.min.js",
              "node_modules/prismjs/components/prism-css.min.js",
              "node_modules/prismjs/components/prism-bash.min.js",
              "node_modules/prismjs/components/prism-json.min.js",
              "node_modules/prismjs/plugins/line-numbers/prism-line-numbers.js"
            ],
            "loader": {
              ".ttf": "file",
              ".woff": "file",
              ".woff2": "file",
              ".eot": "file",
              ".s": "text"
            },
            "webWorkerTsConfig": "tsconfig.worker.json"
          },
          "configurations": {
            "dev": {
              "optimization": false,
              "outputHashing": "media",
              "sourceMap": true,
              "extractLicenses": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/_environment.ts",
                  "with": "src/environments/environment.dev.ts"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "80mb",
                  "maximumError": "100mb"
                }
              ]
            },
            "web": {
              "optimization": {
                "scripts": true,
                "styles": { "minify": true, "inlineCritical": false },
                "fonts": true
              },
              "outputHashing": "all",
              "sourceMap": true,
              "extractLicenses": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/_environment.ts",
                  "with": "src/environments/environment.web.ts"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "10mb",
                  "maximumError": "12mb"
                }
              ]
            },
            "production": {
              "optimization": {
                "scripts": true,
                "styles": { "minify": true, "inlineCritical": false },
                "fonts": true
              },
              "outputHashing": "all",
              "sourceMap": false,
              "extractLicenses": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/_environment.ts",
                  "with": "src/environments/environment.production.ts"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "10mb",
                  "maximumError": "12mb"
                }
              ]
            },
            "mobile": {
              "outputPath": {
                "base": "dist-mobile"
              },
              "optimization": {
                "scripts": true,
                "styles": { "minify": true, "inlineCritical": false },
                "fonts": true
              },
              "outputHashing": "all",
              "sourceMap": false,
              "extractLicenses": true,
              "fileReplacements": [
                {
                  "replace": "src/environments/_environment.ts",
                  "with": "src/environments/environment.production.ts"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "10mb",
                  "maximumError": "12mb"
                }
              ]
            }
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "thumder-angular-electron:build"
          },
          "configurations": {
            "dev": {
              "buildTarget": "thumder-angular-electron:build:dev"
            },
            "web": {
              "buildTarget": "thumder-angular-electron:build:web"
            },
            "production": {
              "buildTarget": "thumder-angular-electron:build:production"
            }
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "thumder-angular-electron:build:dev",
            "tsConfig": "src/tsconfig.spec.json",
            "runner": "vitest",
            "setupFiles": [
              "src/test-setup.ts"
            ]
          }
        }
      }
    }
  },
  "schematics": {
    "@schematics/angular:component": {
      "prefix": "app",
      "style": "scss"
    },
    "@schematics/angular:directive": {
      "prefix": "app"
    }
  }
}
